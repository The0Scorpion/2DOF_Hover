    {
        "id": "ad7994264e3d16e2",
        "type": "function",
        "z": "a7b7c5e75081ab56",
        "name": "function 1",
        "func": "// Input message with payload containing xpos and other properties\nvar inputMessage = msg.payload;\n\nif (\"xpos\" in inputMessage) {\n    var xpos = { payload: inputMessage.xpos };\n    var ypos = { payload: inputMessage.ypos };\n    var xvel = { payload: inputMessage.xvel };\n    var yvel = { payload: inputMessage.yvel };\n    var xpospid = { payload: inputMessage.xposPID };\n    var xvelpid = { payload: inputMessage.xvelPID };\n    var ypospid = { payload: inputMessage.yposPID };\n    var yvelpid = { payload: inputMessage.yvelPID };\n    return [xpos, ypos, xvel, xvel, xpospid,xvelpid, ypospid,yvelpid];\n} else {\n    // If \"xpos\" is not present, return an empty message\n    return null;\n}\n",
