    {
        "id": "663c65c6f883fb10",
        "type": "function",
        "z": "a7b7c5e75081ab56",
        "name": "function 9",
        "func": "// Input messages with numerical values for each key\nvar xposkp = global.get(\"xposkp\") || 0;\nvar xposki = global.get(\"xposki\") || 0;\nvar xposkd = global.get(\"xposkd\") || 0;\n\nvar yposkp = global.get(\"yposkp\") || 0;\nvar yposki = global.get(\"yposki\") || 0;\nvar yposkd = global.get(\"yposkd\") || 0;\n\nvar xvelkp = global.get(\"xvelkp\") || 0;\nvar xvelki = global.get(\"xvelki\") || 0;\nvar xvelkd = global.get(\"xvelkd\") || 0;\n\nvar yvelkp = global.get(\"yvelkp\") || 0;\nvar yvelki = global.get(\"yvelki\") || 0;\nvar yvelkd = global.get(\"yvelkd\") || 0;\n\nvar xsp = global.get(\"xsp\") || 0;\nvar ysp = global.get(\"ysp\") || 0;\n\n// Create a new message with the concatenated payload\nmsg.payload = {\n    \"xposkp\": xposkp,\n    \"xposki\": xposki,\n    \"xposkd\": xposkd,\n    \"yposkp\": yposkp,\n    \"yposki\": yposki,\n    \"yposkd\": yposkd,\n    \"xvelkp\": xvelkp,\n    \"xvelki\": xvelki,\n    \"xvelkd\": xvelkd,\n    \"yvelkp\": yvelkp,\n    \"yvelki\": yvelki,\n    \"yvelkd\": yvelkd,\n    \"xposSet\": xsp,\n    \"yposSet\": ysp\n};\n\n// Send the modified message to the next node\nreturn msg;",
